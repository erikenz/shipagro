{
  "name": "shipagro",
  "version": "0.1.0",
  "description": "CRM and price-alert tracker for Argentine grain businesses (hackathon MVP)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "feed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/feed/run.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/email-nodemailer": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/plugin-import-export": "3.92.0",
    "@payloadcms/plugin-multi-tenant": "3.92.0",
    "@payloadcms/translations": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "lucide-react": "^1.61.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "payload": "3.92.0",
    "radix-ui": "^1.8.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.31",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "packageManager": "pnpm@12.15.0"
}
