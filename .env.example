# Postgres. Locally this is the container from docker-compose.yml.
# In v0, connect Neon under Project Settings > Integrations; it sets DATABASE_URL for you.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/shipagro

# Any long random string.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# reMarkets (A3 test environment) credentials, used by `pnpm feed`.
# Sign in at https://remarkets.primary.ventures/ and copy them from Mi Cuenta > Datos Usuario.
A3_USERNAME=
A3_PASSWORD=

# Optional SMTP for alert emails. Without SMTP_HOST, development emails go to
# ethereal.email and Payload logs a preview link to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alertas@shipagro.local
